{
  "connectors": [
    {
      "id": "anthropic",
      "label": "Anthropic Claude Enterprise",
      "platform": "anthropic",
      "enabled": false,
      "configured": false,
      "problems": [
        "anthropic.api_key"
      ],
      "describe": {
        "fields": [
          {
            "key": "anthropic.api_key",
            "label": "API key",
            "type": "secret",
            "hint": "Analytics key, starts with sk-ant-api01-."
          },
          {
            "key": "anthropic.rebuild_days",
            "label": "Re-pull days",
            "type": "number",
            "min": 1,
            "max": 31,
            "default": 9,
            "hint": "1 to 31. Recent days are fetched again because the vendor revises them for about a week."
          },
          {
            "key": "anthropic.base_url",
            "label": "Base URL",
            "type": "text",
            "advanced": true,
            "default": "https://api.anthropic.com",
            "hint": "Change only to reach the API through a proxy."
          },
          {
            "key": "anthropic.anthropic_version",
            "label": "API version",
            "type": "text",
            "advanced": true,
            "default": "2023-06-01",
            "hint": "Sent as the anthropic-version header."
          }
        ],
        "history_floor": "2026-01-01",
        "help": [
          "The primary owner of the Enterprise organization creates the Analytics key at claude.ai under Organization settings, API.",
          "The key needs the read:analytics scope, and read:rbac_groups adds team mapping."
        ]
      }
    },
    {
      "id": "github",
      "label": "GitHub Copilot",
      "platform": "github",
      "enabled": true,
      "configured": false,
      "problems": [
        "github.token"
      ],
      "describe": {
        "fields": [
          {
            "key": "github.token",
            "label": "Access token",
            "type": "secret",
            "hint": "Fine-grained or classic token with read access to Copilot metrics."
          },
          {
            "key": "github.enterprise",
            "label": "Enterprise slug",
            "type": "text",
            "placeholder": "cg-enterprise",
            "hint": "The slug in github.com/enterprises/<slug>."
          },
          {
            "key": "github.scope",
            "label": "Scope",
            "type": "select",
            "options": [
              {
                "value": "enterprise",
                "label": "Enterprise"
              },
              {
                "value": "org",
                "label": "Organization"
              }
            ],
            "default": "enterprise",
            "hint": "Which level the metrics are read from."
          },
          {
            "key": "github.rebuild_days",
            "label": "Re-pull days",
            "type": "number",
            "min": 1,
            "max": 28,
            "default": 7
          },
          {
            "key": "github.include_seats",
            "label": "Include seat assignments",
            "type": "boolean",
            "default": true,
            "hint": "Adds the seat list so inactive seats can be reported."
          },
          {
            "key": "github.base_url",
            "label": "Base URL",
            "type": "text",
            "advanced": true,
            "default": "https://api.github.com"
          }
        ],
        "help": [
          "Create the token as an enterprise owner or billing manager.",
          "The Copilot usage metrics policy must be enabled for the enterprise."
        ]
      }
    },
